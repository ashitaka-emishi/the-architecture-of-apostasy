{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-of-apostasy.faith/schemas/knowledge-graph.schema.json",
  "title": "Grammar of Apostasy Knowledge Graph",
  "type": "object",
  "required": ["nodes", "edges"],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "label"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "type": {
            "type": "string",
            "enum": [
              "concept",
              "term",
              "volume",
              "chapter",
              "source",
              "passage",
              "figure",
              "diagram",
              "claim",
              "objection",
              "agent"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "type"],
        "properties": {
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "defines",
              "depends_on",
              "distorts",
              "embodies",
              "forms",
              "sacrifices",
              "restores",
              "cites",
              "objects_to",
              "resolves",
              "belongs_to",
              "extends"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Troth Artifact Register",
  "type": "object",
  "required": [
    "schema_version",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "status",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "status": {
            "enum": [
              "source",
              "user_established",
              "working_synthesis",
              "proposed",
              "research",
              "deprecated"
            ]
          },
          "role": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}